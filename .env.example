# Copy to .env and edit. All settings are optional; commented lines show the defaults. / .env にコピーして編集します (すべて任意。コメント行は既定値)。

# Folder that holds archive/ (put your ZIPs here), db/ and media/. Create the three subfolders before the first start.
# archive/ (ZIP を置く), db/, media/ を含むフォルダ。初回起動前に 3 つのサブフォルダを作成してください。
#DATA_DIR=./data

# Host port for the web UI. / Web UI を公開するホスト側ポート。
#VIEWER_PORT=8080

# IANA time zone used for displayed dates, the date filter, the calendar and stats (default: UTC). A value saved from the admin screen takes precedence over this. / 日時表示・日付絞り込み・集計のタイムゾーン (IANA 名, 既定: UTC)。管理画面で保存した値が優先されます。
TIMEZONE=Asia/Tokyo

# Only needed with `docker compose --profile tunnel up -d` (Cloudflare Tunnel token). / tunnel プロファイル使用時のみ必要。
#TUNNEL_TOKEN=

# Start the tunnel profile without the --profile flag (e.g. Synology Container Manager). / --profile を付けられない環境 (Synology Container Manager など) で tunnel を有効にする。
#COMPOSE_PROFILES=tunnel
